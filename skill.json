{
  "manifest_version": "v1",
  "id": "smartflow",
  "name": "📊 智汇流周报",
  "version": "1.0.0",
  "description": "智能团队效能周报生成器，自动整合飞书文档、任务、会议多源数据，通过大模型生成高信息密度的工作总结与风险洞察",
  "author": "SmartFlow Team",
  "homepage": "https://github.com/your-org/smartflow",
  "license": "MIT",
  "tags": ["飞书", "周报", "效能", "团队管理", "AI生成"],
  "categories": ["办公效率", "团队协作"],

  "permissions": {
    "feishu": [
      "im:message",
      "im:chat",
      "drive:document",
      "project:task",
      "calendar:calendar",
      "contact:user"
    ],
    "llm": ["chat"],
    "storage": ["kv", "file"],
    "schedule": ["create", "delete", "list"]
  },

  "env_vars": [
    {
      "name": "SMARTFLOW_CONFIG_DIR",
      "description": "配置文件目录，默认 ~/.smartflow/config",
      "required": false
    },
    {
      "name": "SMARTFLOW_DATA_DIR",
      "description": "数据存储目录，默认 ~/.smartflow/data",
      "required": false
    }
  ],

  "skills": [
    {
      "name": "generate",
      "description": "生成团队周报",
      "parameters": {
        "type": "object",
        "properties": {
          "team": {
            "type": "string",
            "description": "团队ID，不指定则使用默认团队"
          },
          "range": {
            "type": "string",
            "description": "时间范围：lastweek(上周), thisweek(本周), lastmonth(上月), thismonth(本月), 或自定义如 2024-01-01~2024-01-07",
            "default": "lastweek"
          },
          "push": {
            "type": "boolean",
            "description": "生成后是否自动推送到配置的渠道",
            "default": false
          },
          "output": {
            "type": "string",
            "description": "输出到文件路径"
          }
        }
      }
    },
    {
      "name": "health",
      "description": "检查服务运行状态"
    },
    {
      "name": "test-push",
      "description": "测试飞书推送功能",
      "parameters": {
        "team": {
          "type": "string",
          "description": "团队ID",
          "required": true
        }
      }
    },
    {
      "name": "config-list",
      "description": "查看所有团队配置列表"
    },
    {
      "name": "setup",
      "description": "启动配置向导，引导完成团队配置"
    }
  ],

  "actions": [
    {
      "name": "approve_report",
      "description": "审核通过周报"
    },
    {
      "name": "reject_report",
      "description": "审核驳回周报"
    },
    {
      "name": "regenerate-report",
      "description": "重新生成周报"
    },
    {
      "name": "push-report",
      "description": "推送周报"
    }
  ],

  "entry": "dist/openclaw/index.js",
  "runtime": "nodejs >= 20.0.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "better-sqlite3": "^11.5.0",
    "dayjs": "^1.11.10",
    "fs-extra": "^11.2.0",
    "node-schedule": "^2.1.1",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },

  "triggers": {
    "cron": [
      {
        "id": "weekly-report-schedule",
        "name": "每周自动生成周报",
        "description": "每周五18:00自动生成并推送周报",
        "cron": "0 18 * * 5",
        "enabled": true,
        "action": {
          "skill": "generate",
          "parameters": {
            "range": "lastweek",
            "push": true
          }
        }
      }
    ],
    "message": [
      {
        "id": "keyword-trigger",
        "name": "关键词触发",
        "description": "当消息包含关键词时触发",
        "keywords": ["生成周报", "生成本周周报", "生成上周周报", "上周总结", "测试推送", "团队列表", "健康检查"],
        "mention": false,
        "priority": 999,
        "action": {
          "skill": "generate",
          "parameters": {
            "range": "lastweek",
            "push": false
          }
        }
      },
      {
        "id": "mention-trigger",
        "name": "@机器人触发",
        "description": "当用户@机器人并包含关键词时触发",
        "keywords": ["生成周报", "生成本周周报", "生成上周周报", "上周总结", "测试推送", "团队列表", "健康检查"],
        "mention": true,
        "priority": 999,
        "action": {
          "skill": "generate",
          "parameters": {
            "range": "lastweek",
            "push": false
          }
        }
      },
      {
        "id": "help-trigger",
        "name": "帮助触发",
        "description": "当用户询问帮助时触发",
        "keywords": ["帮助", "怎么用", "使用说明"],
        "action": {
          "skill": "help"
        }
      },
      {
        "id": "welcome-trigger",
        "name": "欢迎触发",
        "description": "当用户第一次使用或说你好时触发",
        "keywords": ["你好", "hi", "hello", "欢迎"],
        "action": {
          "skill": "welcome"
        }
      },
      {
        "id": "demo-trigger",
        "name": "演示触发",
        "description": "当用户想体验演示功能时触发",
        "keywords": ["演示", "demo", "体验"],
        "action": {
          "skill": "demo"
        }
      },
      {
        "id": "setup-trigger",
        "name": "配置触发",
        "description": "当用户想进行配置时触发",
        "keywords": ["配置", "setup", "设置"],
        "action": {
          "skill": "setup"
        }
      },
      {
        "id": "health-trigger",
        "name": "健康检查触发",
        "description": "当用户想检查服务状态时触发",
        "keywords": ["健康检查", "状态", "health"],
        "action": {
          "skill": "health"
        }
      }
    ]
  }
}
